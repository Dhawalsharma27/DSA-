import java.util.*;
class Solution {
    public int maxDepth(String s) {
        // first we initialize a variable to store the the result of the solution
        int result = 0;
        // now to keep record of open paranthesis count we will use a variable 
        int openpara = 0;
        // loop across the string
        for ( int i = 0 ; i < s.length() ; i++) {
            // check if the characcter at the current index is ( then increase the openpara count
            if (s.charAt(i) == '('){
                openpara += 1;
                // result will be max of current count vs previous count
                result = Math.max(result , openpara);
            // if the character at i index is ) then decrease the count of openpara
            } else if (s.charAt(i) == ')'){
                openpara -=1;
            }
        }
        // at last return the result
        return result;
    }
}

