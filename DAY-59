class Solution {
    public String lexGreaterPermutation(String s, String target) {
        int n = s.length();
        int[] freq = new int[26];
        
        // Count frequencies of all characters in s
        for (char c : s.toCharArray()) {
            freq[c - 'a']++;
        }

        int bestIndex = -1;
        char bestChar = ' ';

        // 1. Find the optimal divergence point
        for (int i = 0; i < n; i++) {
            char t = target.charAt(i);
            
            // Check for the smallest available character strictly greater than t
            for (int j = t - 'a' + 1; j < 26; j++) {
                if (freq[j] > 0) {
                    bestIndex = i;
                    bestChar = (char) (j + 'a');
                    break;
                }
            }

            // Try to match the current character of target to continue extending the prefix
            if (freq[t - 'a'] > 0) {
                freq[t - 'a']--;
            } else {
                // If we can't match t, we can't go any further. Break out.
                break;
            }
        }

        // If we never found a valid point to diverge, no valid permutation exists
        if (bestIndex == -1) {
            return "";
        }

        // 2. Construct the final string
        // Reset frequencies for construction
        int[] remaining = new int[26];
        for (char c : s.toCharArray()) {
            remaining[c - 'a']++;
        }

        StringBuilder sb = new StringBuilder();
        
        // Append the exact matching prefix
        for (int i = 0; i < bestIndex; i++) {
            char c = target.charAt(i);
            sb.append(c);
            remaining[c - 'a']--;
        }

        // Append the divergence character
        sb.append(bestChar);
        remaining[bestChar - 'a']--;

        // Append all leftover characters in alphabetical order
        for (int i = 0; i < 26; i++) {
            while (remaining[i] > 0) {
                sb.append((char) (i + 'a'));
                remaining[i]--;
            }
        }

        return sb.toString();
    }
}

