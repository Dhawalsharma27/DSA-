class Solution:
    def lower_bound(self,arr,target):
        left,right = 0 , len(arr)
        while left < right:
            mid = (left + right) // 2
            if target > arr[mid]:
                left = mid + 1
            else:
                right = mid 
        return left
        
    def upper_bound(self,arr,target):
        left, right = 0 , len(arr)
        while left < right:
            mid = (left + right) // 2
            if arr[mid] <= target:
                left = mid + 1
            else:
                right = mid 
        return left
                
    def countFreq(self, arr, target):
        arr.sort()
        l = self.lower_bound(arr, target)
        r = self.upper_bound(arr, target)
        return r - l 
        
        
if __name__ == "__main__":
    arr = [ 1,3,5,7,9,6]
    target = 3
    ob = Solution()
    ob.countFreq(arr,target)

