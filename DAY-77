class Solution {
    public int reverseDegree(String s) {
        // Final total score store karne ke liye variable initialize kiya
        int result = 0; 
        
        // String ke har character par ek-ek karke loop chalayenge (0 se length - 1 tak)
        for (int i = 0; i < s.length(); i++) {
            
            // Reversed alphabet position nikalne ka logic:
            // s.charAt(i) - 'a' se 0-indexed normal position milti hai ('a' -> 0, 'z' -> 25)
            // 26 se subtract karne par reversed position milti hai:
            // 'a' ban jayega 26 - 0 = 26
            // 'z' ban jayega 26 - 25 = 1
            int revAlphaIndex = 26 - (s.charAt(i) - 'a'); 
            
            // Question ke hisaab se string ki position 1-indexed honi chahiye, isliye (i + 1)
            int stringIndex = i + 1; 
            
            // Dono values ko multiply karke running sum me add kar diya
            result += revAlphaIndex * stringIndex; 
        } 
        
        // Pure string ka calculate kiya hua total reverse degree return kar diya
        return result; 
    } 
}

