import java.util.*;
class Solution {
    public int sumCounts(List<Integer> nums) {
        int n = nums.size();
        int Sum = 0;
        for (int i = 0 ; i < n; i++) {
            // Set is initialized inside the loop so that every time the loop start set is initialized fresh 
            Set<Integer> distinct = new HashSet<>();
            for(int j = i; j < n; j++) {
                // adding the numbers do the set
                distinct.add(nums.get(j));
                // adding the count of the numbers to the count variable
                int count = distinct.size();
                // now adding the square of elements in the count variable to the sum for result
                Sum += count * count;
            }
        }

        return Sum;
        
    }
}

