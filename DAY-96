class Solution {
    public int minOperations(String s) {
        int n = s.length();
        
        // Check if already sorted
        boolean isSorted = true;
        for (int i = 1; i < n; i++) {
            if (s.charAt(i) < s.charAt(i - 1)) {
                isSorted = false;
                break;
            }
        }
        if (isSorted) return 0;
        
        // For length 2, no valid proper substring can reorder the characters
        if (n == 2) return -1;
        
        // Find global minimum and global maximum characters
        char minChar = 'z';
        char maxChar = 'a';
        for (int i = 0; i < n; i++) {
            char c = s.charAt(i);
            if (c < minChar) minChar = c;
            if (c > maxChar) maxChar = c;
        }
        
        // 1 operation is sufficient if s[0] is min or s[n-1] is max
        if (s.charAt(0) == minChar || s.charAt(n - 1) == maxChar) {
            return 1;
        }
        
        // Check if s[0] is the unique maximum and s[n-1] is the unique minimum
        boolean uniqueMaxAtStart = (s.charAt(0) == maxChar);
        boolean uniqueMinAtEnd = (s.charAt(n - 1) == minChar);
        
        if (uniqueMaxAtStart && uniqueMinAtEnd) {
            // Verify if there are other occurrences of maxChar or minChar
            for (int i = 1; i < n; i++) {
                if (s.charAt(i) == maxChar) {
                    uniqueMaxAtStart = false;
                    break;
                }
            }
            for (int i = 0; i < n - 1; i++) {
                if (s.charAt(i) == minChar) {
                    uniqueMinAtEnd = false;
                    break;
                }
            }
            
            if (uniqueMaxAtStart && uniqueMinAtEnd) {
                return 3;
            }
        }
        
        return 2;
    }
}

