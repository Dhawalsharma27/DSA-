class Solution {
    public int[] twoSum(int[] numbers, int target) {
        // n as the length of the array
		int n = numbers.length;
        // two pointer i at 0 and j at n-1
        int j =  n-1 ;
		int i = 0;

        while ( i < j) {

            // calculate the sum
			int sum = numbers[i] + numbers[j];
            // if equal to target return the index
			if ( target  == sum ) return new int[] {i + 1 , j + 1};
            // else if sum < target move forward the i pointer 
			else if (target > sum) i++;
            // else sum > target move the j pointer backward
			else j--;
            
		}
		// not found return the empty
		return new int[] {};
	
	}

} 

