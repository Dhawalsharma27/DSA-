class Solution {
    public String longestCommonPrefix(String[] strs) {
        // Edge Case Check: Agar input array null hai ya empty (length 0) hai, 
        // toh koi common prefix possible nahi hai, empty string "" return karo.
        if (strs == null || strs.length == 0) return "";
        
        // Outer Loop: Pehle string (strs[0]) ke character indices par loop chalayenge (column-by-column scanning).
        for (int i = 0; i < strs[0].length(); i++) {
            // Reference Character: Pehle string ke 'i'th position waale character ko nikal kar store kar rahe hain.
            char c = strs[0].charAt(i);
            
            // Inner Loop: Baaki bache huye saare strings (index 1 se end tak) par traverse karenge.
            for (int j = 1; j < strs.length; j++) {
                // Condition Check:
                // 1. 'i == strs[j].length()': Current string ki length khatam ho gayi hai.
                // 2. 'strs[j].charAt(i) != c': Current string ka character, reference character 'c' se match nahi karta.
                if (i == strs[j].length() || strs[j].charAt(i) != c) {
                    // Mismatch milne par index 0 se lekar (i-1) tak ka prefix substring return kar denge.
                    return strs[0].substring(0, i);
                }
            }
        }
        
        // Agar poora outer loop bina mismatch ke khatam ho gaya, 
        // iska matlab pehla string (strs[0]) hi poora ka poora common prefix hai.
        return strs[0];
    }
}

