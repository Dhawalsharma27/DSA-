class Solution {
    public long minSumSquareDiff(int[] nums1, int[] nums2, int k1, int k2) {
        int n = nums1.length;
        int maxDiff = 0;
        int[] diffCount = new int[100001];
        long totalK = (long) k1 + k2;

        // Step 1: Count frequency of each absolute difference
        for (int i = 0; i < n; i++) {
            int d = Math.abs(nums1[i] - nums2[i]);
            diffCount[d]++;
            if (d > maxDiff) {
                maxDiff = d;
            }
        }

        // Step 2: Greedily reduce the largest differences
        for (int d = maxDiff; d > 0; d--) {
            if (diffCount[d] == 0) continue;

            if (totalK >= diffCount[d]) {
                // We can reduce all elements of size 'd' down to 'd - 1'
                totalK -= diffCount[d];
                diffCount[d - 1] += diffCount[d];
                diffCount[d] = 0;
            } else {
                // We can only reduce part of the elements of size 'd'
                diffCount[d - 1] += (int) totalK;
                diffCount[d] -= (int) totalK;
                totalK = 0;
                break;
            }
        }

        // Step 3: Compute the sum of squared differences
        long ans = 0;
        for (int d = 1; d <= maxDiff; d++) {
            if (diffCount[d] > 0) {
                ans += (long) diffCount[d] * d * d;
            }
        }

        return ans;
    }
}

