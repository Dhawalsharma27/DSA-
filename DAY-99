import java.util.Arrays;

class Solution {
    public String[] createGrid(int m, int n) {
        // Result store karne ke liye m size ka String array banaya
        // Har element ek row ko represent karega
        String[] grid = new String[m];
        
        // --- PEHLI ROW (Index 0) BANANA ---
        // Hum chahte hain ki path (0,0) se seedhe right side end (0, n-1) tak jaye.
        // Isliye row 0 ke saare cells ko '.' (free cell) rakh rahe hain.
        char[] firstRow = new char[n];
        Arrays.fill(firstRow, '.'); // Saare n cells ko '.' se bhar diya
        grid[0] = new String(firstRow); // Is row ko grid ke pehle index par daal diya
        
        // --- BAAKI ROWS (Row 1 se m-1) BANANA ---
        // Agar grid me 1 se zyada rows hain (m > 1):
        if (m > 1) {
            char[] otherRow = new char[n];
            
            // Saari columns me pehle '#' (obstacle) bhar diya taaki koi alternate path na bane
            Arrays.fill(otherRow, '#');
            
            // Sirf aakhri column (index n-1) ko '.' rakha
            // Taaki rightmost cell se seedhe niche (down) destination tak single path ban sake
            otherRow[n - 1] = '.';
            
            // Is pattern ko String me convert kar liya: "###...#."
            String rowPattern = new String(otherRow);
            
            // Row 1 se lekar m-1 tak har row me yahi pattern copy kar diya
            for (int i = 1; i < m; i++) {
                grid[i] = rowPattern;
            }
        }
        
        // Final grid return kar di jisme sirf ek hi valid path hai:
        // (0, 0) -> Right -> (0, n - 1) -> Down -> (m - 1, n - 1)
        return grid;
    }
}

