public class Solution {
    public String intToRoman(int num) {
        // Step 1: Subtractive cases (like 4, 9, 40, etc.) ke saath saare 
        // major Roman values ko descending (bade se chote) order mein array mein rakha hai.
        int[] values = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
        
        // Step 2: Unhi values ke corresponding Roman symbols ki array hai.
        // Index match hona zaroori hai (jaise 1000 ke liye "M", 900 ke liye "CM").
        String[] symbols = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};

        // Step 3: String build karne ke liye StringBuilder ka use kar rahe hain
        // taaki memory efficient rahe (String concatenation se fast hota hai).
        StringBuilder roman = new StringBuilder();

        // Step 4: Sabse badi value (1000) se lekar sabse choti value (1) tak loop chalayenge.
        for (int i = 0; i < values.length; i++) {
            
            // Jab tak humara number current value se bada ya barabar hai...
            while (num >= values[i]) {
                // 1. Number me se wo value minus kar do
                num -= values[i];
                
                // 2. Us value ka Roman symbol string me add kar do
                roman.append(symbols[i]);
            }
        }
        
        // Step 5: Final Roman numeral string return kar do
        return roman.toString();
    }
}

