class Solution {
    public String longestPalindrome(String s) {
        if (s == null || s.length() < 1) return "";
        
        int start = 0, end = 0;
        
        for (int i = 0; i < s.length(); i++) {
            // Case 1: Odd length palindrome (Center ek single character hai, e.g., "aba")
            int len1 = expandAroundCenter(s, i, i);
            
            // Case 2: Even length palindrome (Center do adjacent characters hain, e.g., "abba")
            int len2 = expandAroundCenter(s, i, i + 1);
            
            int maxLen = Math.max(len1, len2);
            
            // Agar naya bada palindrome mila toh boundaries update karo
            if (maxLen > end - start) {
                start = i - (maxLen - 1) / 2;
                end = i + maxLen / 2;
            }
        }
        return s.substring(start, end + 1);
    }
    
    private int expandAroundCenter(String s, int left, int right) {
        // Jab tak characters match ho rahe hain, failte jao
        while (left >= 0 && right < s.length() && s.charAt(left) == s.charAt(right)) {
            left--;
            right++;
        }
        // Palindrome ki actual length return karne ka formula
        return right - left - 1;
    }
}

