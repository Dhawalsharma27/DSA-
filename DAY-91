class Solution {
    public int minInsertions(String s) {
        int insert = 0;
        int open = 0;
        int n = s.length();

        for (int i = 0; i < n; i++) {
            if (s.charAt(i) == '(') {
                open++;
            } else {
                // Check if next character is also ')' to make a pair "))"
                if (i + 1 < n && s.charAt(i + 1) == ')') {
                    i++; // consume the second ')'
                } else {
                    insert++; // single ')', need to insert another ')'
                }

                // Balance this "))" pair with a '('
                if (open > 0) {
                    open--;
                } else {
                    insert++; // need to insert an opening '('
                }
            }
        }

        // Each remaining '(' needs 2 ')'
        return insert + open * 2;
    }
}

