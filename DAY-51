class Solution {
    // Memoization table banayenge taaki same subproblem baar-baar calculate na karni pade
    Integer[][] memo;
    // Range sum jaldi nikalne ke liye prefix sum array use karenge
    int[] prefixSum;

    public int stoneGameV(int[] stoneValue) {
        int n = stoneValue.length;
        memo = new Integer[n][n];
        prefixSum = new int[n + 1];

        // Prefix sum array ko fill kar rahe hain
        // prefixSum[i] store karega sum of elements from index 0 to i-1
        for (int i = 0; i < n; i++) {
            prefixSum[i + 1] = prefixSum[i] + stoneValue[i];
        }

        // DP function call karenge starting se end tak (0 to n-1)
        return solve(stoneValue, 0, n - 1);
    }

    private int solve(int[] stoneValue, int i, int j) {
        // Base case: Agar ek hi stone bacha hai, toh game over. Score 0 hoga.
        if (i == j) {
            return 0;
        }
        
        // Agar yeh range pehle se calculate ho chuki hai, toh wahi se return kardo
        if (memo[i][j] != null) {
            return memo[i][j];
        }

        int maxScore = 0;

        // Hum array ko har possible point 'k' se do parts mein split karenge:
        // Left part: i se k tak
        // Right part: k+1 se j tak
        for (int k = i; k < j; k++) {
            // Prefix sum use karke dono parts ka total sum nikal rahe hain (O(1) time mein)
            int leftSum = prefixSum[k + 1] - prefixSum[i];
            int rightSum = prefixSum[j + 1] - prefixSum[k + 1];

            if (leftSum < rightSum) {
                // Agar left sum chhota hai, toh Bob bada wala (right part) fenk dega.
                // Alice ko leftSum milega aur baaki game left part mein continue hoga.
                maxScore = Math.max(maxScore, leftSum + solve(stoneValue, i, k));
                
            } else if (leftSum > rightSum) {
                // Agar right sum chhota hai, toh Bob left part fenk dega.
                // Alice ko rightSum milega aur game right part mein continue hoga.
                maxScore = Math.max(maxScore, rightSum + solve(stoneValue, k + 1, j));
                
            } else {
                // Agar dono sums equal hain (leftSum == rightSum), toh Alice ke paas choice hai.
                // Wo check karegi ki left part rakhne mein zyada fayda hai ya right part rakhne mein.
                int maxFromLeftChoice = solve(stoneValue, i, k);
                int maxFromRightChoice = solve(stoneValue, k + 1, j);
                
                maxScore = Math.max(maxScore, leftSum + Math.max(maxFromLeftChoice, maxFromRightChoice));
            }
        }

        // Result ko memo array mein save karenge aur return kar denge
        return memo[i][j] = maxScore;
    }
}

