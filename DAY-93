class Solution {
    public String maxSumOfSquares(int num, int sum) {
        // Base impossibility check
        if (sum < 1 || sum > 9 * num) {
            return "";
        }

        // Count how many 9s we can form
        int count9 = sum / 9;
        int rem = sum % 9;

        StringBuilder sb = new StringBuilder();

        // Append all 9s
        for (int i = 0; i < count9; i++) {
            sb.append('9');
        }

        // Append remainder digit if non-zero
        if (rem > 0) {
            sb.append(rem);
        }

        // Pad the rest with 0s to reach exactly 'num' digits
        while (sb.length() < num) {
            sb.append('0');
        }

        return sb.toString();
    }
}

