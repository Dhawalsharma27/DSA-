class Solution {
    public int numberOfSets(int n, int k) {
        int MOD = 1_000_000_007;

        // dp[i][j]: i points (0 se i-1) use karke exactly j segments banane ke total ways
        int[][] dp = new int[n + 1][k + 1];
        
        // prefix[i][j]: dp[1][j] + dp[2][j] + ... + dp[i][j] ka running sum
        // Taaki inner loop ko O(1) me calculate kar sakein
        int[][] prefix = new int[n + 1][k + 1];

        // Base Case: 0 segments banane ka hamesha 1 valid tareeqa hota hai (kuch mat draw karo)
        for (int i = 1; i <= n; i++) {
            dp[i][0] = 1;
            prefix[i][0] = i; // prefix sum for base case
        }

        for (int i = 2; i <= n; i++) {
            for (int j = 1; j <= k; j++) {
                // Option 1: Point (i-1) kisi bhi segment ka end nahi banta
                dp[i][j] = dp[i - 1][j];

                // Option 2: Point (i-1) par ek segment khatam ho raha hai.
                // Segments endpoints share kar sakte hain, iska matlab agar naya segment p se shuru ho
                // raha hai (jahan p < i-1), toh p par purana segment end bhi ho sakta hai ya pehle hi khatam ho chuka ho.
                // Mathematically, yeh sum hota hai: sum_{p=1}^{i-1} (dp[p][j - 1] + dp[p][j - 1] with shared point)
                // Jise simplify karke prefix sum se directly O(1) me liya ja sakta hai:
                dp[i][j] = (dp[i][j] + prefix[i - 1][j - 1]) % MOD;

                // Running prefix sum update kar rahe hain aage ke points ke liye
                prefix[i][j] = (prefix[i - 1][j] + dp[i][j]) % MOD;
            }
        }

        return dp[n][k];
    }
}

