class Solution {
    public boolean isRectangleOverlap(int[] rec1, int[] rec2) {
        // rec format: [x1, y1, x2, y2]
        // Do rectangles tabhi overlap karenge jab dono X aur Y axis pe simultaneously overlap ho

        return rec1[0] < rec2[2] && // rec1 ka left side, rec2 ke right side ke pehle hona chahiye
               rec1[2] > rec2[0] && // rec1 ka right side, rec2 ke left side ke aage hona chahiye (X-axis overlap complete)
               rec1[1] < rec2[3] && // rec1 ka bottom side, rec2 ke top side ke niche hona chahiye
               rec1[3] > rec2[1];   // rec1 ka top side, rec2 ke bottom side ke upar hona chahiye (Y-axis overlap complete)
    }
}

