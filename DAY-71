import java.util.*;
class Solution {
    public int totalNumbers(int[] digits) {
        // first we create a integeer array that will store the count of the the elements in the array
        int[] count = new int[10];
        // now we will itrate through the digits array to count the frequency of the numbers in the digit array and accordingly increase the count int the count integer array
        for(int digit : digits) {
            count[digit]++;
        }
        // to store the result count
        int validNocount = 0;

        for (int num = 100; num <= 998; num+=2){
            // using this we will get the individual elements of the three digit number 
            int hundreds = num/100;
            int tens = (num/10) % 10;
            int units = num % 10;


             // now we will decrease the frequency of the elements int the count array
        count[hundreds]--;
        count[tens]--;
        count[units]--;

        // now we will check whether the frequency of the number is 0 or less then 0 as after decreasing the frequency of the number they can be 0 or more if less then 0 then the number does not exist int the digit array

        if(count[hundreds] >= 0 && count[tens] >= 0 && count[units] >= 0) {
            validNocount++;
        }

        // now again increse the frequency back to the original number
        count[hundreds]++;
        count[tens]++;
        count[units]++;


        }
        return validNocount;

    }

}
















