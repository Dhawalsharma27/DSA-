class Solution {
    public int[] maxDepthAfterSplit(String seq) {
        int n = seq.length();
        int[] ans = new int[n];
        
        // Parentheses ka current nesting level (depth) track karne ke liye
        int depth = 0;

        for (int i = 0; i < n; i++) {
            char c = seq.charAt(i);
            
            if (c == '(') {
                // Opening bracket aane par depth badhao
                depth++;
                // Alternate depth ke hisaab se group 0 ya 1 assign karo
                ans[i] = depth % 2;
            } else {
                // Closing bracket ko uske matching opening bracket wale same group me daalo
                ans[i] = depth % 2;
                // Bracket close hone par depth ghatao
                depth--;
            }
        }

        return ans;
    }
}
