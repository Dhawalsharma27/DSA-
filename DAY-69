Another way :- 

class Solution {
    public long countCommas(long n) {
        // first intialize the result  
        long result = 0;
        // starting point
        long start = 1000;
        // until the start is less then the n 
        while(start <= n) {
            // update the result first we calculate for fisrt comma and then we will update the start form the next interval and re calculate the number and append in the result 
            result += (n - start + 1);
            // update the start
            start *= 1000;
        }
        return result;
    }
}
