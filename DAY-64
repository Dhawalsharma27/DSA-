        int min = Integer.MAX_VALUE;
        // first find the minimum element
        for( int i = 0; i < n; i++) {
            min = Math.min(min,nums1[i]);
        }
        // check if the minimum element is odd if yes then return true as using it we can ture all the array to odd
        if(min % 2 == 1){
            return true;
        }
        // if not then check whether there is any odd number in the array if ye then return false as if there is a odd number we cant turn the whole array to even array 
        // else return true 
        for(int num : nums1){
            if(num % 2 == 1){
                return false;
            }
