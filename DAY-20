import java.util.Stack;
class Solution {
    public int[] dailyTemperatures(int[] temperatures) {
        // ek stack bana rahe hai jismei 
        Stack<Integer> st = new Stack<>();
        // ek variable bana rahe hai jismei temperature array ka length store karenge
        int n = temperatures.length;
        // ek integer array ban rahe hai jismei humlog answer store karenge
        int[] answer = new int[n];
        // ek loop chalayenge
        for (int i = 0; i< n ; i++) {
            // check karenge ki stack empty hai ki nahi aur agar jo current index temperature hai vo stack ke peek mei jo temperature se bada hai ki nahi
            while (!st.isEmpty() && temperatures[i] > temperatures[st.peek()]){
                // agar bda hai toh stack se pop kardo element ko aur previous index name ke variable mei store kardo
                int prevIndex =st.pop();
                // aur answer array array mei prevIndex par uska i ka index aur prevIndex ka index ka diffrence 
                answer[prevIndex] = i - prevIndex;
            }
        // agar bada nahi hai toh stack mei us element ko push kardo
        st.push(i);
        }

    return answer;
    }
}


