class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int n = nums1.length;
        int m = nums2.length;
        // ek vairable banayenge to get the idx we will use to calculate the median
        int size = n + m;
    
        int idx1 = (size / 2) - 1;
        int element1 = 0;
        int idx2 = size / 2;
        int element2 = 0;

        int i = 0;
        int j = 0;
        int k = 0;
        while(i < n && j < m) {
            int currentVal;
            if ( nums1[i] < nums2[j] ) {
                currentVal = nums1[i];
                i++;
                    
            } else {
                currentVal = nums2[j];
                j++;
            }
                
            if (k == idx1) element1 = currentVal;
            if (k == idx2) element2 = currentVal;
            k++;
        }
        
        while (i < n) {
            if (k == idx1) element1 = nums1[i];
            if (k == idx2) element2 = nums1[i];
            i++;
            k++;
        }

        while (j < m) {
            if (k == idx1) element1 = nums2[j];
            if (k == idx2) element2 = nums2[j];
            j++;
            k++;
        }
        

        double  answer = 0;
        if(size % 2 == 1) {
            answer = element2;
        } else {
            answer = (element1 + element2)  / 2.0;
        }

        return answer;
    }
}

