class Solution {
    private Boolean[][][] memo;
    private int m, n;

    public boolean hasValidPath(char[][] grid) {
        m = grid.length;
        n = grid[0].length;

        // Path length is m + n - 1. Must be even to be balanced.
        if ((m + n - 1) % 2 != 0) return false;
        // Start must be '(' and end must be ')'
        if (grid[0][0] == ')' || grid[m - 1][n - 1] == '(') return false;

        // open count cannot exceed (m + n) / 2
        int maxOpen = (m + n) / 2;
        memo = new Boolean[m][n][maxOpen + 1];

        return dfs(grid, 0, 0, 0);
    }

    private boolean dfs(char[][] grid, int r, int c, int open) {
        // Adjust open bracket count
        if (grid[r][c] == '(') {
            open++;
        } else {
            open--;
        }

        // Invalid prefix balance or exceeded maximum possible open brackets
        if (open < 0 || open > (m + n) / 2) {
            return false;
        }

        // Reached destination: check if all brackets are balanced
        if (r == m - 1 && c == n - 1) {
            return open == 0;
        }

        if (memo[r][c][open] != null) {
            return memo[r][c][open];
        }

        boolean found = false;

        // Move Down
        if (r + 1 < m) {
            found = dfs(grid, r + 1, c, open);
        }

        // Move Right
        if (!found && c + 1 < n) {
            found = dfs(grid, r, c + 1, open);
        }

        return memo[r][c][open] = found;
    }
}

